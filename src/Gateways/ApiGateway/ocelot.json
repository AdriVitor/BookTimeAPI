{
  "Routes": [
    // ---------------------------------------------------------------
    // AuthService (público) - emissão de token
    // ---------------------------------------------------------------
    {
      "DownstreamPathTemplate": "/api/v1/login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5211 } ],
      "UpstreamPathTemplate": "/api/v1/login",
      "UpstreamHttpMethod": [ "POST" ]
    },

    // ---------------------------------------------------------------
    // UserService - endpoints públicos (criação e verificação de login)
    // ---------------------------------------------------------------
    {
      "DownstreamPathTemplate": "/api/v1/Users/Exists",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/users/exists",
      "UpstreamHttpMethod": [ "POST" ],
      "Priority": 2
    },
    {
      "DownstreamPathTemplate": "/api/v1/Users",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/users",
      "UpstreamHttpMethod": [ "POST" ]
    },

    // ---------------------------------------------------------------
    // UserService - endpoints protegidos (Users / Roles / UserRoles)
    // ---------------------------------------------------------------
    {
      "DownstreamPathTemplate": "/api/v1/Users/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/users/{everything}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/Roles",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/roles",
      "UpstreamHttpMethod": [ "GET" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/Roles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/roles/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/UserRoles",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/userroles",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/UserRoles/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5223 } ],
      "UpstreamPathTemplate": "/api/v1/userroles/{everything}",
      "UpstreamHttpMethod": [ "GET", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },

    // ---------------------------------------------------------------
    // ResourceService (protegido) - controller sem versionamento (api/resource)
    // ---------------------------------------------------------------
    {
      "DownstreamPathTemplate": "/api/v1/resource",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5111 } ],
      "UpstreamPathTemplate": "/api/v1/resource",
      "UpstreamHttpMethod": [ "GET", "POST" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/resource/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5111 } ],
      "UpstreamPathTemplate": "/api/v1/resource/{everything}",
      "UpstreamHttpMethod": [ "GET", "PUT", "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },

    // ---------------------------------------------------------------
    // BookingService (protegido) - controller Reservation + rotas absolutas
    // ---------------------------------------------------------------
    {
      "DownstreamPathTemplate": "/api/v1/Reservation",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5053 } ],
      "UpstreamPathTemplate": "/api/v1/reservation",
      "UpstreamHttpMethod": [ "POST" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/Reservation/Update",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5053 } ],
      "UpstreamPathTemplate": "/api/v1/reservation/update",
      "UpstreamHttpMethod": [ "PUT" ],
      "Priority": 2,
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/api/v1/Reservation/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5053 } ],
      "UpstreamPathTemplate": "/api/v1/reservation/{id}",
      "UpstreamHttpMethod": [ "DELETE" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/Resource/{resourceId}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5053 } ],
      "UpstreamPathTemplate": "/api/v1/reservation/resource/{resourceId}",
      "UpstreamHttpMethod": [ "GET" ],
      "Priority": 2,
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    },
    {
      "DownstreamPathTemplate": "/{id}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "localhost", "Port": 5053 } ],
      "UpstreamPathTemplate": "/api/v1/reservation/{id}",
      "UpstreamHttpMethod": [ "GET" ],
      "AuthenticationOptions": { "AuthenticationProviderKeys": [ "Bearer" ] }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5159"
  }
}
